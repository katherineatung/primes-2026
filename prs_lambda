def prs(lambda1, lambda2):
    s=SymmetricFunctions(QQ).s()
    a=s(lambda1)
    n=len(lambda2)
    poly=a.expand(n)
    terms=poly.terms()
    return_partition=[t(*tuple(lambda2)) for t in terms]
    return_partition.sort(reverse=True)
    return return_partition

